<script src="//apps.bdimg.com/libs/jquery/2.1.4/jquery.min.js"></script>
<script src='//cdn.bootcss.com/node-waves/0.7.5/waves.min.js'></script>
<script src="//cdn.bootcss.com/scrollReveal.js/3.3.2/scrollreveal.min.js"></script>
<script src="<%= cdn_asset('js/jquery.fitvids.js') %>"></script>
<script>
	var GOOGLE_CUSTOM_SEARCH_API_KEY = "<%- theme.search.google_api_key %>";
	var GOOGLE_CUSTOM_SEARCH_ENGINE_ID = "<%- theme.search.google_engine_id %>";
	var ALGOLIA_API_KEY = "<%- theme.search.algolia_api_key %>";
	var ALGOLIA_APP_ID = "<%- theme.search.algolia_app_id %>";
	var ALGOLIA_INDEX_NAME = "<%- theme.search.algolia_index_name %>";
  var AZURE_SERVICE_NAME = "<%- theme.search.azure_service_name %>";
  var AZURE_INDEX_NAME = "<%- theme.search.azure_index_name %>";
  var AZURE_QUERY_KEY = "<%- theme.search.azure_query_key %>";
  var BAIDU_API_ID = "<%- theme.search.baidu_api_id %>";
  var SEARCH_SERVICE = "<%- theme.search.service %>";
  var ROOT = "<%- config.root %>"||"/";
  if(!ROOT.endsWith('/'))ROOT += '/';
</script>
<script src="<%= cdn_asset('js/search.js') %>"></script>
<script src="<%= cdn_asset('js/theme.js') %>"></script>
<%
  var commentsConfig = theme.comments || {};
  var commentsType = String(commentsConfig.type || '').toLowerCase();
  var twikooConfig = commentsConfig.twikoo || {};
  var walineConfig = commentsConfig.waline || {};
  var artalkConfig = commentsConfig.artalk || {};
%>
<script>
window.__COMMENT_COUNT_CONFIG__ = {
  type: <%- JSON.stringify(commentsType) %>,
  twikoo: {
    envId: <%- JSON.stringify(twikooConfig.envId || '') %>,
    src: <%- JSON.stringify(commentsType === 'twikoo' ? cdn_module('twikoo', '1', 'dist/twikoo.min.js', twikooConfig.src) : '') %>
  },
  waline: { serverURL: <%- JSON.stringify(walineConfig.serverURL || '') %> },
  artalk: { server: <%- JSON.stringify(artalkConfig.server || '') %> }
};
</script>
<script src="<%= cdn_asset('js/comment-count.js') %>"></script>
<script async data-busuanzi src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
<script src="<%= cdn_asset('js/app.js') %>"></script>
<% if (pjax_enabled()) { %>
<script src="<%= pjax_script() %>"></script>
<script src="<%= cdn_asset('js/pjax-init.js') %>"></script>
<% } %>

