<article class="post reveal<%= (post.title) ? "" : " no-title" %><%= post.cover ? " has-cover" : "" %>">
  <section class="meta">
    <% if (post.title) { %>
    <h2 class="title">
      <a href="<%- url_for(post.path) %>">
        <%= post.title %>
      </a>
    </h2>
    <% } %>
    <div class="meta-line">
      <% if (post.tags && post.tags.length) { %>
      <span class="tags">
        <% post.tags.each(function(item){ %><a href="<%- url_for(item.path) %>">#<%= item.name %></a><% }) %>
      </span>
      <% } %>
      <%- partial('categories',{post:post}) %>
      <time>
        <%= date(post.date, 'YYYY-MM-DD') %>
      </time>
    </div>
  </section>
  <% if (post.cover) { %>
  <a class="post-cover" href="<%- url_for(post.path) %>" aria-hidden="true" tabindex="-1">
    <img src="<%= post.cover %>" alt="<%= post.title %>" loading="lazy" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='/img/bg.jpg';">
  </a>
  <% } %>
</article>
